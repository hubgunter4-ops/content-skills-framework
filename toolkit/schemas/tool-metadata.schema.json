{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-skills-framework.local/schemas/tool-metadata.schema.json",
  "title": "ToolMetadata",
  "type": "object",
  "required": ["id", "version", "name", "description", "input_schema", "output_schema", "contract_version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "input_schema": {"type": "string", "minLength": 1},
    "output_schema": {"type": "string", "minLength": 1},
    "contract_version": {"const": "1.0"},
    "phase": {"type": ["string", "null"]},
    "entrypoint": {"type": ["string", "null"]},
    "script": {"type": ["string", "null"]},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output_formats": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "anyOf": [{"required": ["entrypoint"]}, {"required": ["script"]}],
  "additionalProperties": false
}
