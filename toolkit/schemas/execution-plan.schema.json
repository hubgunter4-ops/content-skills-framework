{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-skills-framework.local/schemas/execution-plan.schema.json",
  "title": "ExecutionPlan",
  "type": "object",
  "required": ["steps", "requires_confirmation", "plan_id"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "tool_id", "input_from"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "tool_id": {"type": "string", "minLength": 1},
          "input_from": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "requires_confirmation": {"type": "boolean"},
    "plan_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
